digraph HLD {
  graph [rankdir=TB, fontname="Helvetica", fontsize=24, labelloc=t, label="Historify trading engine - target HLD   (ideas in → one backtest process → paper → live → trade data out)\n ", newrank=true, nodesep=0.5, ranksep=0.55, pad=0.4, bgcolor="white", splines=spline];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, fillcolor="#ffffff", color="#555555", penwidth=1.2, margin="0.18,0.1", width=3.2];
  edge  [fontname="Helvetica", fontsize=11, color="#555555", penwidth=1.4];

  subgraph cluster_idea {
    label="① Idea generation engine (yours)"; style="rounded,filled"; fillcolor="#f3e8ff"; color="#7e22ce"; fontsize=16; fontcolor="#581c87";
    IG [label="Idea generator\nhypotheses · variants · own backtests", fillcolor="#faf5ff"];
    IA [label="Analytics / retraining\nconsumes TradeEvents", fillcolor="#faf5ff"];
  }

  subgraph cluster_research {
    label="② RESEARCH NODE · Historify (desktop)"; style="rounded,filled"; fillcolor="#eff6ff"; color="#1d4ed8"; fontsize=16; fontcolor="#1e3a8a";
    DP  [label="Data platform\ndownloads · ledger · integrity\nrefdata · corporate actions\ncalendar · news & intel", fillcolor="#dbeafe"];
    SNAP[label="Lab snapshot v2\nONE data source\ncontent-addressed partitions\n+ PIT reference bundle", fillcolor="#dbeafe"];
    GW  [label="Idea Gateway\nschema · signature · IR compile\nlook-ahead fuzz · dedupe (IR sha)", fillcolor="#fef9c3", color="#a16207"];
    BT  [label="UNIFIED BACKTEST PIPELINE\n(one process)\nrequest → data → hbt-core kernel\n→ artefacts → run + trial registry", fillcolor="#fde68a", color="#a16207", penwidth=2.4, fontsize=14];
    EV  [label="Evaluation gate\nWFO · DSR (N = generator + ours)\nPBO · robustness · capacity\nreproduce the claimed metrics", fillcolor="#fef9c3", color="#a16207"];
    LC  [label="Idea lifecycle\nreceived → validated → evaluated\n→ shadow → paper → approval\n→ live pilot → live", fillcolor="#fef9c3", color="#a16207"];
    AP  [label="Human approval\nevidence bundle · typed sign-off", fillcolor="#fee2e2", color="#b91c1c", penwidth=1.8];
  }

  subgraph cluster_trading {
    label="③ TRADING NODE · VPS with static IP (same codebase, `historify trader`)"; style="rounded,filled"; fillcolor="#ecfdf5"; color="#047857"; fontsize=16; fontcolor="#064e3b";
    MD  [label="Market data\nWebSocket → 1m bars\n(provisional → final)\nREST finality repair", fillcolor="#d1fae5"];
    SR  [label="Strategy runtime\nhbt-core step_bar per (idea, symbol)\n→ intents, never orders", fillcolor="#d1fae5"];
    PR  [label="Portfolio risk\ncapital per idea · exposure caps\ncorrelation budget · global loss stop", fillcolor="#d1fae5"];
    EG  [label="EXECUTION GATEWAY\n(one order path)\npre-trade guardrails → OMS\n(journal-first, idempotent)\nreconciliation · ONE kill switch", fillcolor="#a7f3d0", color="#047857", penwidth=2.4, fontsize=14];
    AD  [label="Broker adapters\nSimulated (G1) │ Analyzer (G2)\n│ Live (G3/G4)", fillcolor="#d1fae5"];
    TS  [label="Trade store + Outbox\nsame transaction as the OMS\n→ relay", fillcolor="#d1fae5"];
    OB  [label="Observability\n/metrics · latency · alerts\nhash-chained audit log", fillcolor="#f0fdf4"];
  }

  subgraph cluster_ext {
    label="④ Broker side"; style="rounded,filled"; fillcolor="#f5f5f4"; color="#57534e"; fontsize=16;
    OA [label="OpenAlgo (on the VPS)\nAnalyzer ON = paper\nAnalyzer OFF = live", fillcolor="#fafaf9"];
    BR [label="Broker API (Angel One)\n→ NSE", fillcolor="#fafaf9"];
  }

  IG -> GW  [label="IdeaSpec v1\nIR + ExecSpec + universe\n+ risk + trials_tested (signed)", color="#7e22ce", fontcolor="#7e22ce", penwidth=2.4];
  DP -> SNAP;
  GW -> BT  [label="validated idea"];
  SNAP -> BT [label="bars + PIT refs"];
  BT -> EV;
  EV -> LC  [label="evidence bundle"];
  LC -> AP  [label="paper gates met", color="#b91c1c", fontcolor="#b91c1c"];
  AP -> LC  [label="approved", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
  LC -> SR  [constraint=false, label="frozen IdeaVersion\n(IR sha + ExecSpec sha + limits)\nstage shadow | paper | live", color="#1d4ed8", fontcolor="#1d4ed8", penwidth=2.4];
  SNAP -> MD [label="morning warm-up", style=dashed, constraint=false];
  MD -> SR  [label="bar close + 2-5 s"];
  SR -> PR  [label="intents"];
  PR -> EG  [label="sized orders"];
  EG -> AD;
  AD -> OA  [constraint=false, label="orders\n(mode checked before every order)", penwidth=2.4];
  OA -> BR [constraint=false];
  OA -> MD  [label="ticks", style=dashed, constraint=false];
  EG -> TS  [label="every state change"];
  EG -> OB  [style=dotted, arrowhead=none];
  TS -> IA  [label="TradeEvents\nwebhook (HMAC) · pull API · nightly Parquet", color="#7e22ce", fontcolor="#7e22ce", penwidth=2.4, constraint=false];
  TS -> LC  [label="nightly parity · session summaries → auto-demotion", style=dashed, color="#047857", fontcolor="#047857", constraint=false];

  {rank=same; IG; IA;}
  {rank=same; GW; DP; }
  {rank=same; SNAP; MD;}
  {rank=same; BT; SR;}
  {rank=same; EV; PR;}
  {rank=same; LC; EG; OA;}
  {rank=same; AP; AD; TS; OB; BR;}
}
