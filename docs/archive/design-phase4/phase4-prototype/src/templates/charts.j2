{% extends "_layout.j2" %}
{% set active = "charts" %}
{% block title %}Charts{% endblock %}
{% block data_scripts %}<script defer src="assets/data/SBIN_NSE_5m.js"></script><script defer src="assets/data/SBIN_NSE_D.js"></script>{% endblock %}
{% block heading %}Charts{% endblock %}
{% block content %}
<div x-data="chartPage" class="flex gap-4">
  <div class="min-w-0 flex-1">
    {# ------------------------------------------------------------ toolbar #}
    <div class="card-h flex flex-wrap items-center gap-2 p-2">
      <button class="btn btn-sm gap-2 border-base-300 bg-base-100">
        <span class="font-semibold">SBIN</span><span class="text-base-content/50">NSE</span>{{ icon("chevron-down", "h-3.5 w-3.5") }}
      </button>
      <div class="join">
        {% for iv in ["1m", "3m", "5m", "15m", "30m", "1h"] %}
          <button class="btn btn-sm join-item" data-iv="{{ iv }}" @click="pickInterval">{{ iv }}</button>
        {% endfor %}
      </div>
      <div class="join">
        {% for iv, tip in [("D", "Daily"), ("W", "Weekly - derived from D"), ("M", "Monthly - derived from D")] %}
          <button class="btn btn-sm join-item" title="{{ tip }}" data-iv="{{ iv }}" @click="pickInterval">{{ iv }}</button>
        {% endfor %}
      </div>
      <div class="divider divider-horizontal mx-0"></div>
      <div class="join">
        {% for r in ["1D", "5D", "1M", "3M", "1Y", "All"] %}<button class="btn btn-ghost btn-sm join-item">{{ r }}</button>{% endfor %}
      </div>
      <button class="btn btn-sm gap-1 border-base-300 bg-base-100">{{ icon("activity") }} Indicators <span class="badge badge-sm">3</span></button>
      <label class="ml-auto flex cursor-pointer items-center gap-2 text-sm">
        <input type="checkbox" class="toggle toggle-primary toggle-sm" checked> Follow live
      </label>
      <button class="btn btn-ghost btn-sm btn-square" title="Save image">{{ icon("camera") }}</button>
      <button class="btn btn-ghost btn-sm btn-square" title="Full screen">{{ icon("maximize-2") }}</button>
    </div>

    {# ------------------------------------------------------------ chart #}
    <div class="card-h relative mt-3 overflow-hidden">
      <div class="pointer-events-none absolute left-3 top-2 z-10 text-xs leading-5">
        <div><b class="text-sm">SBIN</b> <span class="text-base-content/55">· NSE · <span x-text="interval"></span> · IST</span></div>
        <div class="num">
          <span class="text-base-content/50">O</span> <span x-text="legend.o"></span>
          <span class="ml-1 text-base-content/50">H</span> <span x-text="legend.h"></span>
          <span class="ml-1 text-base-content/50">L</span> <span x-text="legend.l"></span>
          <span class="ml-1 text-base-content/50">C</span> <span x-text="legend.c"></span>
          <span class="ml-1" :class="legendTone" x-text="legend.chg"></span>
          <span class="ml-2 text-base-content/50">Vol</span> <span x-text="legend.v"></span>
        </div>
        <div class="num"><span class="text-[#6366f1]">EMA 20</span> <span x-text="legend.e20"></span> <span class="ml-2 text-[#f59e0b]">EMA 50</span> <span x-text="legend.e50"></span></div>
      </div>
      <div id="chart" class="h-[560px] w-full"></div>
    </div>

    {# ------------------------------------------------------------ coverage strip #}
    <div class="card-h mt-3 p-3">
      <div class="mb-2 flex items-center justify-between text-xs text-base-content/60">
        <span>Stored data for this series (one tick per session)</span>
        <span><span class="mr-3"><span class="inline-block h-2 w-2 rounded-sm bg-primary/70"></span> stored</span><span class="mr-3"><span class="inline-block h-2 w-2 rounded-sm bg-error"></span> missing</span><span><span class="inline-block h-2 w-2 rounded-sm bg-base-content/25"></span> loaded in chart</span></span>
      </div>
      <div class="flex h-5 items-end gap-px">
        {% for sess in strip %}
          <div title="{{ sess.day }}{{ ' - missing' if sess.missing }}" class="flex-1 rounded-sm {{ 'h-5 bg-error' if sess.missing else ('h-3 bg-primary/70' if not sess.loaded else 'h-3 bg-primary/70 ring-1 ring-base-content/40') }}"></div>
        {% endfor %}
      </div>
      <div class="mt-1 flex justify-between text-[11px] text-base-content/50"><span>{{ strip[0].day }} 2025</span><span>{{ strip|length }} sessions · 1 missing ({% for s in strip if s.missing %}{{ s.day }}{% endfor %}) · last 5 loaded in chart</span><span>{{ strip[-1].day }} 2025</span></div>
    </div>
  </div>

  {# ------------------------------------------------------------ series panel #}
  <aside class="w-72 shrink-0 space-y-3">
    <div class="card-h p-4 text-sm">
      <h2 class="mb-3 font-semibold">Series</h2>
      <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
        <dt class="text-base-content/55">Stored</dt><dd class="num text-right text-xs">27 Jan → 28 Mar 2025</dd>
        <dt class="text-base-content/55">Bars</dt><dd class="num text-right text-xs" x-text="stats.total"></dd>
        <dt class="text-base-content/55">Loaded</dt><dd class="num text-right text-xs" x-text="stats.loaded"></dd>
        <dt class="text-base-content/55">Last sync</dt><dd class="text-right text-xs">15:46 IST · today</dd>
        <dt class="text-base-content/55">Freshness</dt><dd class="text-right"><span class="chip chip-ok">final to 15:25</span></dd>
        <dt class="text-base-content/55">Gaps</dt><dd class="text-right"><span class="chip chip-warn">1 session</span></dd>
      </dl>
      <div class="mt-3 flex gap-2">
        <button class="btn btn-sm flex-1">{{ icon("wrench") }} Repair gap</button>
        <button class="btn btn-sm flex-1">{{ icon("history") }} Backfill</button>
      </div>
    </div>
    <div class="card-h p-4 text-sm">
      <h2 class="mb-2 font-semibold">Follow live</h2>
      <p class="text-xs leading-5 text-base-content/65">While the NSE session is open, Historify runs a small incremental job for this series after each 5-minute bar closes (~1 request / 5 min). The chart picks up new and revised bars via <code class="num">since=</code> polling. Stops automatically at 15:30 IST.</p>
      <div class="mt-2 flex items-center gap-2 text-xs text-base-content/60"><span class="h-2 w-2 rounded-full bg-base-content/30"></span> NSE closed at 15:30 · resumes Tue 01 Apr 09:20 IST</div>
    </div>
    <div class="card-h p-4 text-sm">
      <h2 class="mb-2 font-semibold">Indicators</h2>
      <ul class="space-y-1.5 text-xs">
        <li class="flex items-center gap-2"><span class="h-0.5 w-4 bg-[#6366f1]"></span> EMA 20 <span class="ml-auto text-base-content/45">price pane</span></li>
        <li class="flex items-center gap-2"><span class="h-0.5 w-4 bg-[#f59e0b]"></span> EMA 50 <span class="ml-auto text-base-content/45">price pane</span></li>
        <li class="flex items-center gap-2"><span class="h-0.5 w-4 bg-[#8b5cf6]"></span> RSI 14 <span class="ml-auto text-base-content/45">pane 2</span></li>
      </ul>
      <p class="mt-2 text-[11px] text-base-content/50">Computed in the browser over the loaded bars; recomputed when older pages load.</p>
    </div>
  </aside>
</div>
{% endblock %}
